+def stem_italian_word(word: str) -> str:
+    """Semplice e deterministico normalizzatore morfologico per sostantivi e aggettivi italiani."""
+    w = word.strip().casefold()
+    if len(w) <= 3:
+        return w
+    if w.endswith("i"):
+        return w[:-1]
+    if w.endswith("e") and len(w) > 4:
+        return w[:-1]
+    if w.endswith(("o", "a")) and len(w) > 4:
+        return w[:-1]
+    return w
+
