+            content = json.dumps({
+                "topics": [
+                    {
+                        "label": f"Argomento Chunk {chunk_idx}",
+                        "short_description": f"Descrizione oggettiva per blocco {chunk_idx}",
+                        "evidence_ids": [f"msg_doc_ubuntu_synth_1049_{chunk_idx}::ORIGINAL_TEXT"],
+                    }
+                ]
+            })
