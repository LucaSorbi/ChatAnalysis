+"""
+scripts/measure_scalability_and_profiling.py
+--------------------------------------------
+Misurazione e profilazione preventiva della scalabilità su dataset sintetici progressivi
+(100, 1.000, 10.000 e 50.000 messaggi), conforme alla Sezione 4 e Sezione 8.1 dell'Audit.
+
+Parametri misurati:
+- Tempo di preparazione (ingestion/bundling)
+- Numero di chunk prima (chunking basato su bundles=25 fissi) vs dopo (chunking token-aware)
+- Riduzione percentuale del numero di inferenze necessarie
+- Tempo di consolidamento/aggregazione topic
+- Memoria di picco (tracemalloc MB)
+- Copertura delle evidenze (verifica conservazione 100% evidenze e ordine)
+"""
+from __future__ import annotations
+
+import json
+import os
+import sys
+import time
+import tracemalloc
+from pathlib import Path
+
+# Add project root to path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from ai.chunking import profile_document_for_analysis, split_document_into_chunks
+from ai.models import (
+    ConversationEvidenceDocument,
+    DiscoveredTopic,
+    TopicDiscoveryResult,
+)
+from ai.backend import BaseLlmClient, LlmCompletionResponse
+from ai.structured import TOPIC_DISCOVERY_SCHEMA
+from analysis.service import LocalTopicAnalysisService, aggregate_topic_discovery
+from analysis.models import OperationalAnalysisConfig
+from importer.models import RawRecord
+from multimodal.evidence import MessageEvidenceBundle
+from normalization.models import (
+    CanonicalMessageType,
+    NormalizedRecord,
+    NormalizedTimestamp,
+    TimestampTzStatus,
+)
+from unified.models import UnifiedMessage
+from validation.models import ValidationResult
+
+
+class ScalabilityBenchmarkMockClient(BaseLlmClient):
+    """Client mock deterministico per validare l'effettivo percorso di run_topic_discovery."""
+
+    def chat_completion(
+        self,
+        messages: list[dict[str, str]],
+        model_id: str | None = None,
+        schema: dict | None = None,
+        temperature: float = 0.0,
+        max_tokens: int | None = None,
+        timeout_seconds: float = 60.0,
+        seed: int | None = 42,
+        **kwargs,
+    ) -> LlmCompletionResponse:
+        user_content = messages[-1]["content"] if messages else ""
+        import re
+        m = re.search(r"unified:whatsapp_perf:\d+::ORIGINAL_TEXT", user_content)
+        eid = m.group(0) if m else "unified:whatsapp_perf:1::ORIGINAL_TEXT"
+        content = json.dumps({
+            "topics": [
+                {
+                    "label": "Argomento Operativo",
+                    "short_description": "Descrizione sintetica",
+                    "evidence_ids": [eid],
+                }
+            ]
+        })
+        return LlmCompletionResponse(
+            content=content,
+            model=model_id or "mock-perf-model",
+            prompt_tokens=200,
+            completion_tokens=60,
+            total_tokens=260,
+            metadata={"finish_reason": "stop"},
+        )
+
+
+def make_synthetic_bundle(idx: int, text: str) -> MessageEvidenceBundle:
+    raw = RawRecord(
+        source_name="whatsapp_perf.txt",
+        source_path="/perf/test.txt",
+        source_record_id=str(idx),
+        record_type="message",
+        raw_fields={"data": text},
+        media_reference=None,
+        metadata={},
+    )
+    val = ValidationResult(record=raw, issues=())
+    ts = NormalizedTimestamp(status=TimestampTzStatus.ABSENT)
+    norm = NormalizedRecord(
+        raw_record=raw,
+        validation_result=val,
+        source_name="whatsapp_perf.txt",
+        source_record_id=str(idx),
+        record_type="message",
+        timestamp=ts,
+        message_type=CanonicalMessageType.TEXT,
+        text_content=text,
+        media_reference=None,
+    )
+    msg = UnifiedMessage(
+        message_id=f"unified:whatsapp_perf:{idx}",
+        source_name="whatsapp_perf.txt",
+        source_record_id=str(idx),
+        source_path="/perf/test.txt",
+        record_type="message",
+        timestamp=ts,
+        message_type=CanonicalMessageType.TEXT,
+        text_content=text,
+        media_reference=None,
+        provenance_record=norm,
+    )
+    return MessageEvidenceBundle(message=msg)
+
+
+def generate_synthetic_document(message_count: int) -> ConversationEvidenceDocument:
+    bundles = []
+    sample_texts = [
+        "Confermo la consegna del materiale concordato per lunedì mattina.",
+        "Il preventivo per la ristrutturazione ammonta a 14500 euro iva inclusa.",
+        "Ci vediamo in ufficio per revisionare le clausole del contratto di locazione.",
+        "Ho inviato la distinta di bonifico bancario tramite email protetta.",
+        "Il container con le merci deperibili è arrivato al porto di Genova.",
+        "I documenti contabili del terzo trimestre sono stati depositati.",
+        "Possiamo aggiornare l'incontro di lavoro alle 15:30 anziché alle 14:00?",
+        "Si richiede l'autorizzazione per la procedura di pagamento frazionato.",
+        "La transazione immobiliare è stata perfezionata presso lo studio notarile.",
+        "Tutti i backup dei database sono stati sincronizzati sul server locale.",
+    ]
+    for i in range(1, message_count + 1):
+        text = sample_texts[(i - 1) % len(sample_texts)]
+        bundles.append(make_synthetic_bundle(i, text))
+
+    return ConversationEvidenceDocument(
+        document_id=f"doc_perf_{message_count}",
+        bundles=tuple(bundles),
+        source_name="whatsapp_perf.txt",
+    )
+
+
+def run_benchmark():
+    test_sizes = [100, 1000, 10000, 50000]
+    results = []
+
+    print("=" * 80)
+    print("CHATANALYSIS — BENCHMARK DETERMINISTICO SCALABILITÀ E CHUNKING OPERATIVO")
+    print("=" * 80)
+
+    # 1. Configurazione Baseline Storica vs Configurazione Ottimizzata Reale
+    baseline_service = LocalTopicAnalysisService(
+        max_chunk_characters=7500,
+        max_chunk_bundles=25,
+        max_chunk_tokens=None,
+    )
+    optimized_service = LocalTopicAnalysisService()  # Usa default reali: 12000 car, 100 bundle, 2500 token
+    mock_client = ScalabilityBenchmarkMockClient()
+
+    print(f"Configurazione Baseline: {baseline_service.max_chunk_characters} char, {baseline_service.max_chunk_bundles} bundle, token={baseline_service.max_chunk_tokens}")
+    print(f"Configurazione Ottimizzata: {optimized_service.max_chunk_characters} char, {optimized_service.max_chunk_bundles} bundle, token={optimized_service.max_chunk_tokens}")
+
+    for count in test_sizes:
+        print(f"\n--- ESECUZIONE TEST SU {count:,} MESSAGGI ---")
+        tracemalloc.start()
+        t0 = time.perf_counter()
+
+        # 1. Preparazione Documento
+        doc = generate_synthetic_document(count)
+        prep_time = round(time.perf_counter() - t0, 4)
+
+        # 2. Profilazione Preventiva
+        profile = profile_document_for_analysis(doc)
+
+        # 3. Chunking Baseline Storico (7500 char, 25 bundle, no token budget)
+        t_c_old = time.perf_counter()
+        old_chunks = split_document_into_chunks(
+            doc,
+            max_characters=7500,
+            max_bundles=25,
+            max_tokens=None,
+        )
+        old_chunk_count = len(old_chunks)
+        time_c_old = round(time.perf_counter() - t_c_old, 4)
+
+        # 4. Chunking Ottimizzato Token-Aware (12000 char, 100 bundle, dynamic token budget)
+        eff_tokens = optimized_service._calculate_effective_chunk_token_budget(
+            context_length=8192,
+            reserved_output_tokens=1500,
+            schema=TOPIC_DISCOVERY_SCHEMA,
+        )
+        t_c_new = time.perf_counter()
+        new_chunks = split_document_into_chunks(
+            doc,
+            max_characters=optimized_service.max_chunk_characters,
+            max_bundles=optimized_service.max_chunk_bundles,
+            max_tokens=eff_tokens,
+        )
+        new_chunk_count = len(new_chunks)
+        time_c_new = round(time.perf_counter() - t_c_new, 4)
+
+        # 5. Verifica sul percorso reale del service per il dataset da 100 messaggi
+        if count == 100:
+            res_live = optimized_service.run_topic_discovery(
+                document=doc,
+                client=mock_client,
+                model_name="mock-perf-model",
+            )
+            assert res_live.metadata["chunk_count"] == new_chunk_count, (
+                f"Discrepanza tra chunking e service: {res_live.metadata['chunk_count']} != {new_chunk_count}"
+            )
+            assert res_live.metadata["status"] == "COMPLETE"
+            print(f"  -> Verifica run_topic_discovery() riuscita: {res_live.metadata['chunk_count']} chunk, status={res_live.metadata['status']}")
+
+        # 6. Verifica conservazione 100% evidenze
+        all_new_eids = set()
+        for ch in new_chunks:
+            for s in ch.all_evidence_sections:
+                all_new_eids.add(s.evidence_id)
+        original_eids = set(s.evidence_id for s in doc.all_evidence_sections)
+        evidence_coverage = 100.0 if all_new_eids == original_eids else (len(all_new_eids) / len(original_eids) * 100.0)
+
+        # 7. Simulazione Consolidamento Multi-Chunk
+        mock_chunk_results = []
