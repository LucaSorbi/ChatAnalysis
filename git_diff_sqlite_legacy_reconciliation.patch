+def test_10_persistence_performance_linear_scaling() -> None:
+    with tempfile.TemporaryDirectory() as chk_dir:
+        store = AnalysisCheckpointStore(checkpoint_dir=Path(chk_dir))
+        doc = _make_doc("doc_perf", 2)
