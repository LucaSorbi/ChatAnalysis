+                        else:
+                            st.info(f"Nessun checkpoint presente per '{doc_id}'.")
+                    except Exception as exc:
+                        st.error(f"Errore durante la cancellazione dei checkpoint: {exc}")
+
+    return state.get_operational_profile()
