# MANIFEST.in
# Esclusioni rigorose per garantire distribuzioni wheel pulite prive di bytecode e cache

global-exclude __pycache__
global-exclude __pycache__/*
global-exclude *.py[cod]
global-exclude *.pyo
global-exclude *.pyd
global-exclude *.so
global-exclude .pytest_cache
global-exclude .pytest_cache/*
global-exclude *.tmp
global-exclude *.swp

prune tests
prune test_data
prune benchmark_results
